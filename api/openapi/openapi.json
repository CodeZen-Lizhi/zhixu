{
  "openapi": "3.1.0",
  "info": {
    "title": "ZHIXU API",
    "version": "0.1.0",
    "description": "System health and M3 Workspace contracts. Workspace scan reads files without modifying them and registers immutable Source Version metadata; it does not claim parse or index completion."
  },
  "paths": {
    "/livez": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The API process is responding.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Liveness" } } }
          },
          "405": {
            "description": "The method is not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Configuration and PostgreSQL are ready.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          },
          "503": {
            "description": "A required dependency is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "405": {
            "description": "The method is not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/system/status": {
      "get": {
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "description": "Current API and database status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemStatus" } } }
          },
          "405": {
            "description": "The method is not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "post": {
        "operationId": "createWorkspace",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateWorkspaceRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Workspace created with a real Git baseline.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } }
          },
          "400": { "description": "Invalid path, name or Git choice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Workspace root or active Workspace conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Database, Git or Workspace service unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getWorkspace",
        "responses": {
          "200": { "description": "Persisted Workspace with refreshed Git status.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
          "400": { "description": "Invalid Workspace ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workspace not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Persisted Workspace and Git state are inconsistent.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workspace dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/scan": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "scanWorkspace",
        "description": "Safely discovers supported files, hashes them and registers immutable Source/SourceVersion metadata without modifying user files. It does not claim parse or index completion.",
        "responses": {
          "200": { "description": "Stable scan result after Source Version metadata registration.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceScan" } } } },
          "400": { "description": "Invalid Workspace ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workspace not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Filesystem or database dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/workflows": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "startWorkflow",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartWorkflowRequest" } } } },
        "responses": {
          "202": { "description": "Durable Workflow Run accepted; completion is not implied.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowStart" } } } },
          "400": { "description": "Invalid Workflow definition or input.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Definition version or workflow state conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getWorkflowRun",
        "responses": {
          "200": { "description": "Current durable Workflow Run state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowRun" } } } },
          "400": { "description": "Invalid Run ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workflow Run not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}/human-tasks/{task_id}/decision": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "submitHumanDecision",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HumanDecisionRequest" } } } },
        "responses": {
          "200": { "description": "Human Task submitted once and Workflow resumed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HumanTask" } } } },
          "400": { "description": "Invalid decision contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Human Task not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Task already resolved, expired or version-conflicted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Liveness": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "alive" } }
      },
      "Readiness": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "ready" } }
      },
      "DatabaseStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "unavailable"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      },
      "SystemStatus": {
        "type": "object",
        "required": ["status", "version", "database", "request_id"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "degraded"] },
          "version": { "type": "string", "minLength": 1 },
          "database": { "$ref": "#/components/schemas/DatabaseStatus" },
          "request_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "required": ["name", "root_path", "initialize_git"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "root_path": { "type": "string", "minLength": 1 },
          "initialize_git": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "GitStatus": {
        "type": "object",
        "required": ["present", "repository_path", "branch", "head", "dirty", "checked_at"],
        "properties": {
          "present": { "type": "boolean" },
          "repository_path": { "type": "string", "minLength": 1 },
          "branch": { "type": "string" },
          "head": { "type": "string" },
          "dirty": { "type": "boolean" },
          "checked_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "required": ["id", "name", "root_path", "status", "version", "git", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "root_path": { "type": "string", "minLength": 1 },
          "status": { "const": "active" },
          "version": { "type": "integer", "minimum": 1 },
          "git": { "$ref": "#/components/schemas/GitStatus" },
          "warnings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "ScannedFile": {
        "type": "object",
        "required": ["relative_path", "byte_size", "content_hash", "media_type"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "byte_size": { "type": "integer", "minimum": 0 },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "media_type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "WorkspaceScan": {
        "type": "object",
        "required": ["workspace_id", "files", "count"],
        "properties": {
          "workspace_id": { "type": "string", "format": "uuid" },
          "files": { "type": "array", "items": { "$ref": "#/components/schemas/ScannedFile" } },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "StartWorkflowRequest": {
        "type": "object",
        "required": ["definition_key", "definition_version", "graph", "input", "first_node_key", "first_node_type"],
        "properties": {
          "definition_key": { "type": "string", "minLength": 1 },
          "definition_version": { "type": "integer", "minimum": 1 },
          "graph": { "type": "object", "additionalProperties": true },
          "input": {},
          "first_node_key": { "type": "string", "minLength": 1 },
          "first_node_type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "WorkflowStart": {
        "type": "object",
        "required": ["workflow_run_id", "status", "status_url"],
        "properties": {
          "workflow_run_id": { "type": "string", "format": "uuid" },
          "status": { "const": "pending" },
          "status_url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "WorkflowRun": {
        "type": "object",
        "required": ["id", "workspace_id", "definition_id", "status", "input", "version", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": { "type": "string", "format": "uuid" },
          "definition_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "running", "waiting_for_human", "succeeded", "failed", "cancelled"] },
          "input": {},
          "output": {},
          "version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "HumanDecisionRequest": {
        "type": "object",
        "required": ["workspace_id", "target_version", "decision"],
        "properties": {
          "workspace_id": { "type": "string", "format": "uuid" },
          "target_version": { "type": "integer", "minimum": 1 },
          "decision": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "HumanTask": {
        "type": "object",
        "required": ["id", "run_id", "node_run_id", "status", "target_version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid" },
          "node_run_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "submitted", "expired", "cancelled"] },
          "target_version": { "type": "integer", "minimum": 1 },
          "decision": { "type": "object", "additionalProperties": true },
          "submitted_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["error_code", "message", "retryable"],
        "properties": {
          "error_code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "workflow_run_id": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    }
  }
}
