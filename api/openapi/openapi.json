{
  "openapi": "3.1.0",
  "info": {
    "title": "ZHIXU API",
    "version": "0.1.0",
    "description": "System health, Workspace, durable Workflow and M5 Change Control contracts. Apply preflight reads the real Workspace file hash but never writes files or creates Git commits."
  },
  "paths": {
    "/livez": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "The API process is responding.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Liveness" } } }
          },
          "405": {
            "description": "The method is not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Configuration and PostgreSQL are ready.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } }
          },
          "503": {
            "description": "A required dependency is unavailable.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "405": {
            "description": "The method is not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/system/status": {
      "get": {
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "description": "Current API and database status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemStatus" } } }
          },
          "405": {
            "description": "The method is not supported.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "post": {
        "operationId": "createWorkspace",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateWorkspaceRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Workspace created with a real Git baseline.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } }
          },
          "400": { "description": "Invalid path, name or Git choice.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Workspace root or active Workspace conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Database, Git or Workspace service unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getWorkspace",
        "responses": {
          "200": { "description": "Persisted Workspace with refreshed Git status.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
          "400": { "description": "Invalid Workspace ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workspace not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Persisted Workspace and Git state are inconsistent.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workspace dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/scan": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "scanWorkspace",
        "description": "Safely discovers supported files, hashes them and registers immutable Source/SourceVersion metadata without modifying user files. It does not claim parse or index completion.",
        "responses": {
          "200": { "description": "Stable scan result after Source Version metadata registration.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceScan" } } } },
          "400": { "description": "Invalid Workspace ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workspace not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Filesystem or database dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/source-versions/{source_version_id}/ingestion-attempts": {
      "parameters": [
        { "name": "source_version_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "processSourceVersion",
        "description": "Validates, parses and chunks immutable Content Artifact bytes. Replays are idempotent and return persisted Attempt state.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestionRequest" } } } },
        "responses": {
          "201": { "description": "A new Ingestion Attempt completed and persisted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestionResult" } } } },
          "200": { "description": "An idempotent replay returned the persisted Attempt or Projection.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IngestionResult" } } } },
          "400": { "description": "Invalid Source Version, request or media/content policy.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "403": { "description": "The source was quarantined.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Source Version or Content Artifact not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Attempt, content or projection consistency conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Filesystem, parser or database dependency unavailable.", "content": { "application/json": { "$ref": "#/components/schemas/Problem" } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "$ref": "#/components/schemas/Problem" } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/workflows": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "startWorkflow",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartWorkflowRequest" } } } },
        "responses": {
          "202": { "description": "Durable Workflow Run accepted; completion is not implied.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowStart" } } } },
          "400": { "description": "Invalid Workflow definition or input.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Definition version or workflow state conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getWorkflowRun",
        "responses": {
          "200": { "description": "Current durable Workflow Run state.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowRun" } } } },
          "400": { "description": "Invalid Run ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workflow Run not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}/pause": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "pauseWorkflow",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowControlRequest" } } } },
        "responses": {
          "200": { "description": "Workflow pause command persisted or replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowControlResult" } } } },
          "400": { "description": "Invalid control request or idempotency key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workflow Run not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Workflow version or control conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}/resume": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "resumeWorkflow",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowControlRequest" } } } },
        "responses": {
          "200": { "description": "Workflow resume command persisted or replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowControlResult" } } } },
          "400": { "description": "Invalid control request or idempotency key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workflow Run not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Workflow version or control conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}/cancel": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "cancelWorkflow",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowControlRequest" } } } },
        "responses": {
          "200": { "description": "Workflow cancel command persisted or replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowControlResult" } } } },
          "400": { "description": "Invalid control request or idempotency key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Workflow Run not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Workflow version or control conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workflows/{run_id}/human-tasks/{task_id}/decision": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "submitHumanDecision",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HumanDecisionRequest" } } } },
        "responses": {
          "200": { "description": "Human Task submitted once and Workflow resumed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HumanTask" } } } },
          "400": { "description": "Invalid decision contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Human Task not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Task already resolved, expired or version-conflicted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workflow dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/proposals": {
      "parameters": [
        { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ],
      "post": {
        "operationId": "createProposal",
        "description": "Creates a ready-for-review Proposal and immutable Revision. No Workspace file is modified.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProposalRequest" } } } },
        "responses": {
          "201": { "description": "Proposal and first Revision created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Proposal" } } } },
          "200": { "description": "The same idempotent request was replayed; the existing Proposal is returned.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Proposal" } } } },
          "400": { "description": "Invalid target, hash or required Proposal field.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Workspace or persistence consistency conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Change Control dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/proposals/{proposal_id}": {
      "parameters": [
        { "name": "proposal_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getProposal",
        "responses": {
          "200": { "description": "Current consistent Proposal, Revision and optional Approval snapshot.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Proposal" } } } },
          "400": { "description": "Invalid Proposal ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Proposal not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Change Control dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/proposals/{proposal_id}/approvals": {
      "parameters": [
        { "name": "proposal_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "decideProposal",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProposalDecisionRequest" } } } },
        "responses": {
          "201": { "description": "Decision created. Approved responses atomically include the unique Safe Writeback Workflow dispatch; Rejected responses contain no Workflow fields.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovalDecisionResponse" } } } },
          "200": { "description": "The exact immutable decision and, for Approved, the same Workflow/Node/River dispatch binding were replayed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApprovalDecisionResponse" } } } },
          "400": { "description": "Invalid decision contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Proposal or Revision not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Proposal is not ready, already decided, or Change Hash mismatched.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Change Control dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    },
    "/api/v1/proposals/{proposal_id}/apply-preflight": {
      "parameters": [
        { "name": "proposal_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "post": {
        "operationId": "checkProposalApplyPreflight",
        "description": "Reads the real target file hash inside the persisted Workspace and verifies Approval, Revision, Change Hash and base hash. It performs no write and issues no write authorization.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyPreflightRequest" } } } },
        "responses": {
          "200": { "description": "Current preflight checks passed; write_performed is always false.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplyPreflightResult" } } } },
          "400": { "description": "Invalid preflight contract.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "403": { "description": "Proposal has no valid approval.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "404": { "description": "Proposal or target not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "409": { "description": "Revision, Change Hash or real target base hash conflict; baseline conflict moves Proposal to needs_revision.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "503": { "description": "Workspace or Change Control dependency unavailable.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "405": { "description": "The method is not supported.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Liveness": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "alive" } }
      },
      "Readiness": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "ready" } }
      },
      "DatabaseStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "unavailable"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      },
      "SystemStatus": {
        "type": "object",
        "required": ["status", "version", "database", "request_id"],
        "properties": {
          "status": { "type": "string", "enum": ["ready", "degraded"] },
          "version": { "type": "string", "minLength": 1 },
          "database": { "$ref": "#/components/schemas/DatabaseStatus" },
          "request_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "required": ["name", "root_path", "initialize_git"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "root_path": { "type": "string", "minLength": 1 },
          "initialize_git": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "GitStatus": {
        "type": "object",
        "required": ["present", "repository_path", "branch", "head", "dirty", "checked_at"],
        "properties": {
          "present": { "type": "boolean" },
          "repository_path": { "type": "string", "minLength": 1 },
          "branch": { "type": "string" },
          "head": { "type": "string" },
          "dirty": { "type": "boolean" },
          "checked_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "required": ["id", "name", "root_path", "status", "version", "git", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1 },
          "root_path": { "type": "string", "minLength": 1 },
          "status": { "const": "active" },
          "version": { "type": "integer", "minimum": 1 },
          "git": { "$ref": "#/components/schemas/GitStatus" },
          "warnings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "ScannedFile": {
        "type": "object",
        "required": ["relative_path", "byte_size", "content_hash", "media_type", "source_id", "source_version_id", "content_artifact_id", "content_artifact_created"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "byte_size": { "type": "integer", "minimum": 0 },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "media_type": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "format": "uuid" },
          "source_version_id": { "type": "string", "format": "uuid" },
          "content_artifact_id": { "type": "string", "format": "uuid" },
          "content_artifact_created": { "type": "boolean", "description": "True when this scan published the managed immutable bytes; false when an identical artifact was reused." }
        },
        "additionalProperties": false
      },
      "WorkspaceScan": {
        "type": "object",
        "required": ["workspace_id", "files", "count"],
        "properties": {
          "workspace_id": { "type": "string", "format": "uuid" },
          "files": { "type": "array", "items": { "$ref": "#/components/schemas/ScannedFile" } },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "IngestionRequest": {
        "type": "object",
        "required": ["attempt_number"],
        "properties": {
          "workflow_run_id": { "type": "string", "format": "uuid" },
          "attempt_number": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "IngestionResult": {
        "type": "object",
        "required": ["attempt_id", "attempt_created", "attempt_number", "status", "security_status", "retryable", "projection_created", "chunk_count", "warning_count"],
        "properties": {
          "attempt_id": { "type": "string", "format": "uuid" },
          "attempt_created": { "type": "boolean" },
          "attempt_number": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["validating", "parsing", "parsed", "chunking", "chunked", "parse_failed", "cancelled"] },
          "security_status": { "type": "string", "enum": ["pending", "passed", "quarantined"] },
          "failure_stage": { "type": "string" },
          "error_code": { "type": "string" },
          "retryable": { "type": "boolean" },
          "parse_projection_id": { "type": "string", "format": "uuid" },
          "projection_created": { "type": "boolean" },
          "chunk_count": { "type": "integer", "minimum": 0 },
          "warning_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "StartWorkflowRequest": {
        "type": "object",
        "required": ["definition_key", "definition_version", "input"],
        "properties": {
          "definition_key": { "type": "string", "minLength": 1 },
          "definition_version": { "type": "integer", "minimum": 1 },
          "graph": { "type": "object", "additionalProperties": true, "deprecated": true, "description": "Deprecated compatibility field; must match the server-registered canonical graph." },
          "input": {},
          "first_node_key": { "type": "string", "minLength": 1, "deprecated": true },
          "first_node_type": { "type": "string", "minLength": 1, "deprecated": true }
        },
        "additionalProperties": false
      },
      "WorkflowStart": {
        "type": "object",
        "required": ["workflow_run_id", "status", "status_url"],
        "properties": {
          "workflow_run_id": { "type": "string", "format": "uuid" },
          "status": { "const": "pending" },
          "status_url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "WorkflowRun": {
        "type": "object",
        "required": ["id", "workspace_id", "definition_id", "status", "input", "version", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": { "type": "string", "format": "uuid" },
          "definition_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "running", "waiting_for_human", "retry_wait", "paused", "succeeded", "failed", "cancelled"] },
          "input": {},
          "output": {},
          "version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "HumanDecisionRequest": {
        "type": "object",
        "required": ["target_version", "decision"],
        "properties": {
          "target_version": { "type": "integer", "minimum": 1 },
          "decision": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      },
      "WorkflowControlRequest": {
        "type": "object",
        "required": ["expected_version"],
        "properties": { "expected_version": { "type": "integer", "minimum": 1 } },
        "additionalProperties": false
      },
      "WorkflowControlResult": {
        "type": "object",
        "required": ["workflow_run_id", "status", "version", "status_url"],
        "properties": {
          "workflow_run_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "running", "waiting_for_human", "retry_wait", "paused", "succeeded", "failed", "cancelled"] },
          "version": { "type": "integer", "minimum": 1 },
          "status_url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "HumanTask": {
        "type": "object",
        "required": ["id", "run_id", "node_run_id", "status", "target_version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "run_id": { "type": "string", "format": "uuid" },
          "node_run_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["pending", "submitted", "expired", "cancelled"] },
          "target_version": { "type": "integer", "minimum": 1 },
          "decision": { "type": "object", "additionalProperties": true },
          "submitted_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "CreateProposalRequest": {
        "type": "object",
        "required": ["target_path", "base_hash", "content", "evidence_summary", "risk", "rollback_plan"],
        "properties": {
          "target_path": { "type": "string", "minLength": 1, "description": "Workspace-relative POSIX path; absolute paths, backslashes and traversal are rejected." },
          "base_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "content": { "type": "string", "minLength": 1 },
          "evidence_summary": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "rollback_plan": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "ProposalRevision": {
        "type": "object",
        "required": ["id", "revision_no", "base_hash", "content", "evidence_summary", "risk", "rollback_plan", "change_hash", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "revision_no": { "type": "integer", "minimum": 1 },
          "base_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "content": { "type": "string", "minLength": 1 },
          "evidence_summary": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "rollback_plan": { "type": "string", "minLength": 1 },
          "change_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Approval": {
        "type": "object",
        "required": ["id", "proposal_id", "revision_id", "change_hash", "decision", "decided_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "proposal_id": { "type": "string", "format": "uuid" },
          "revision_id": { "type": "string", "format": "uuid" },
          "change_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "approved_git_head": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
          "decided_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "ApprovalDecisionResponse": {
        "type": "object",
        "description": "Approved decisions include workflow_run_id, workflow_status_url and dispatch_status. Rejected decisions omit all three fields.",
        "required": ["id", "proposal_id", "revision_id", "change_hash", "decision", "decided_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "proposal_id": { "type": "string", "format": "uuid" },
          "revision_id": { "type": "string", "format": "uuid" },
          "change_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "approved_git_head": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
          "workflow_run_id": { "type": "string", "format": "uuid" },
          "workflow_status_url": { "type": "string", "pattern": "^/api/v1/workflows/[0-9a-f-]{36}$" },
          "dispatch_status": { "type": "string", "enum": ["queued", "running", "replayed"] },
          "decided_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "Proposal": {
        "type": "object",
        "required": ["id", "workspace_id", "target_path", "status", "revision", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": { "type": "string", "format": "uuid" },
          "target_path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["draft", "validating", "ready_for_review", "approved", "applying", "applied", "verifying", "completed", "rejected", "needs_revision", "deferred", "apply_failed", "verify_failed", "rolled_back", "cancelled"] },
          "revision": { "$ref": "#/components/schemas/ProposalRevision" },
          "approval": { "$ref": "#/components/schemas/Approval" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "ProposalDecisionRequest": {
        "type": "object",
        "required": ["revision_id", "change_hash", "decision"],
        "properties": {
          "revision_id": { "type": "string", "format": "uuid" },
          "change_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] }
        },
        "additionalProperties": false
      },
      "ApplyPreflightRequest": {
        "type": "object",
        "required": ["revision_id", "approved_change_hash"],
        "properties": {
          "revision_id": { "type": "string", "format": "uuid" },
          "approved_change_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "additionalProperties": false
      },
      "ApplyPreflightResult": {
        "type": "object",
        "required": ["proposal_id", "revision_id", "change_hash", "base_hash", "preflight_passed", "mode", "write_performed"],
        "properties": {
          "proposal_id": { "type": "string", "format": "uuid" },
          "revision_id": { "type": "string", "format": "uuid" },
          "change_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "base_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "preflight_passed": { "const": true },
          "mode": { "const": "preflight_only" },
          "write_performed": { "const": false }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["error_code", "message", "retryable"],
        "properties": {
          "error_code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "workflow_run_id": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    }
  }
}
