# This file contains both Compose/launcher variables and process configuration.
# For direct API/Worker/Migrate binaries, a present registered process setting
# overrides optional YAML selected by -config, then code defaults; an explicit
# empty value is still an override. ModelCtl currently has no -config flag. See
# docs/operations.md for process profiles and Secret lookup gates.
ZHIXU_VERSION=dev
ZHIXU_ENVIRONMENT=development
ZHIXU_HTTP_PORT=8080
ZHIXU_AUTH_MODE=disabled
# For required mode, generate a fresh value before Compose startup, for example:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ZHIXU_AUTH_BOOTSTRAP_TOKEN=
# API-only HMAC key for Review question references. This checked-in value is
# development-only; replace it before any non-development Compose deployment.
# Use at least 32 UTF-8 bytes with no surrounding whitespace.
ZHIXU_REVIEW_QUESTION_REF_KEY=zhixu_dev_review_question_ref_key_change_me
ZHIXU_AUTH_SESSION_TTL=12h
ZHIXU_AUTH_API_TOKEN_TTL=720h
ZHIXU_AUTH_SECURE_COOKIE=false
# Compose derives the default exact Origin from ZHIXU_HTTP_PORT. Set this only
# when the browser uses a different exact scheme/host/port.
# ZHIXU_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080
ZHIXU_POSTGRES_DB=zhixu
ZHIXU_POSTGRES_USER=zhixu
ZHIXU_POSTGRES_PASSWORD=zhixu_dev_only_change_me
# Select an existing host Workspace with `./zhixu up --workspace /absolute/path`.
# The launcher remembers it locally; no parent or fallback path is mounted.
ZHIXU_HEALTH_INTERVAL=15s
ZHIXU_GRAPH_QUERY_TIMEOUT=2s
# The normal Compose stack stores model settings in PostgreSQL and keeps the
# encryption master key in a dedicated named volume. Keep all legacy static
# Chat/Embedding variables below at these canonical defaults when using
# ./zhixu; configure managed models in Settings and apply them through the
# managed model workflow. Change static variables only for direct binaries or
# isolated smoke overlays.
ZHIXU_MODEL_SETTINGS_MODE=managed
ZHIXU_WORKER_HEALTH_ADDR=0.0.0.0:8081
ZHIXU_WORKER_QUEUE=workflow
ZHIXU_WORKER_MAX_WORKERS=4
ZHIXU_WORKER_JOB_TIMEOUT=15m
ZHIXU_WORKER_RESCUE_STUCK_AFTER=30m
ZHIXU_WORKFLOW_LEASE=2m
ZHIXU_WORKFLOW_HEARTBEAT=30s
ZHIXU_REINDEX_DISPATCH_POLL_INTERVAL=1s
ZHIXU_REINDEX_DISPATCH_BATCH_SIZE=10
ZHIXU_REINDEX_DISPATCH_ERROR_BACKOFF=5s
ZHIXU_REINDEX_LEASE_DURATION=2m
ZHIXU_REINDEX_HEARTBEAT_INTERVAL=30s
# Static/direct-binary Embedding is opt-in. OpenAI-compatible endpoints require
# HTTPS and a key; Ollama keeps the key empty and permits loopback HTTP.
ZHIXU_EMBEDDING_PROVIDER=disabled
ZHIXU_EMBEDDING_BASE_URL=
ZHIXU_EMBEDDING_API_KEY=
ZHIXU_EMBEDDING_MODEL=
ZHIXU_EMBEDDING_DIMENSIONS=0
ZHIXU_EMBEDDING_NORMALIZATION=l2
ZHIXU_EMBEDDING_DISTANCE_METRIC=cosine
ZHIXU_EMBEDDING_MAX_BATCH_SIZE=128
ZHIXU_EMBEDDING_MAX_INPUT_BYTES=65536
ZHIXU_EMBEDDING_MAX_BATCH_INPUT_BYTES=8388608
ZHIXU_EMBEDDING_TIMEOUT=30s
ZHIXU_EMBEDDING_MAX_RESPONSE_BYTES=67108864
# Static/direct-binary Chat is opt-in. Remote endpoints must use HTTPS;
# loopback HTTP is allowed for an OpenAI-compatible local endpoint such as
# Ollama. Disabled mode leaves endpoint, key, model, and model version empty.
ZHIXU_CHAT_PROVIDER=disabled
ZHIXU_CHAT_BASE_URL=
ZHIXU_CHAT_API_KEY=
ZHIXU_CHAT_MODEL=
ZHIXU_CHAT_MODEL_VERSION=
ZHIXU_CHAT_ADAPTER_VERSION=v1
ZHIXU_CHAT_TIMEOUT=30s
ZHIXU_CHAT_MAX_REQUEST_BYTES=4194304
ZHIXU_CHAT_MAX_RESPONSE_BYTES=4194304
# Tool execution defaults to disabled in code and Compose. This development
# example explicitly enables the local Tool runtime for the fixed Tool smoke.
# Enabling Web Fetch only enables configuration; production composition still
# requires an eligible persisted Web Policy. Web Fetch never inherits environment
# proxies and has no private-network exception.
ZHIXU_TOOL_RUNTIME_MODE=enabled
ZHIXU_WEB_FETCH_MODE=disabled
ZHIXU_WEB_FETCH_TIMEOUT=30s
ZHIXU_WEB_FETCH_RESPONSE_HEADER_TIMEOUT=10s
ZHIXU_WEB_FETCH_TLS_HANDSHAKE_TIMEOUT=10s
ZHIXU_WEB_FETCH_MAX_REDIRECTS=5
ZHIXU_WEB_FETCH_MAX_URL_BYTES=8192
ZHIXU_WEB_FETCH_MAX_RESPONSE_HEADER_BYTES=65536
ZHIXU_WEB_FETCH_MAX_BODY_BYTES=2097152
ZHIXU_WEB_FETCH_MAX_TEXT_BYTES=524288
ZHIXU_WEB_FETCH_MAX_RESOLVED_IPS=16
ZHIXU_WEB_FETCH_ALLOWED_CONTENT_TYPES=text/plain,text/html
ZHIXU_RETRIEVAL_RRF_K=60
ZHIXU_RETRIEVAL_RRF_LEXICAL_CANDIDATE_LIMIT=200
ZHIXU_RETRIEVAL_RRF_VECTOR_CANDIDATE_LIMIT=200
ZHIXU_RETRIEVAL_RRF_FUSED_CANDIDATE_LIMIT=100
ZHIXU_RETRIEVAL_RRF_RERANK_CANDIDATE_LIMIT=50
ZHIXU_WORKER_SOFT_STOP_TIMEOUT=30s
ZHIXU_WORKER_HARD_STOP_TIMEOUT=60s
ZHIXU_WORKER_STOP_GRACE_PERIOD=70s
ZHIXU_TELEMETRY_MODE=disabled
# Set ZHIXU_TELEMETRY_MODE=optional|required before enabling this endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
