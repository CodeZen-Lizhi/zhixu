ZHIXU_VERSION=dev
ZHIXU_HTTP_PORT=8080
ZHIXU_POSTGRES_DB=zhixu
ZHIXU_POSTGRES_USER=zhixu
ZHIXU_POSTGRES_PASSWORD=zhixu_dev_only_change_me
ZHIXU_WORKSPACE_ROOT=../workspace
ZHIXU_HEALTH_INTERVAL=15s
ZHIXU_WORKER_HEALTH_ADDR=0.0.0.0:8081
ZHIXU_WORKER_QUEUE=workflow
ZHIXU_WORKER_MAX_WORKERS=4
ZHIXU_WORKER_JOB_TIMEOUT=15m
ZHIXU_WORKER_RESCUE_STUCK_AFTER=30m
ZHIXU_WORKFLOW_LEASE=2m
ZHIXU_WORKFLOW_HEARTBEAT=30s
ZHIXU_REINDEX_DISPATCH_POLL_INTERVAL=1s
ZHIXU_REINDEX_DISPATCH_BATCH_SIZE=10
ZHIXU_REINDEX_DISPATCH_ERROR_BACKOFF=5s
ZHIXU_REINDEX_LEASE_DURATION=2m
ZHIXU_REINDEX_HEARTBEAT_INTERVAL=30s
# Embedding is opt-in. For OpenAI-compatible, use an HTTPS base URL and set
# ZHIXU_EMBEDDING_API_KEY. For Ollama, API key must stay empty; loopback HTTP is allowed.
ZHIXU_EMBEDDING_PROVIDER=disabled
ZHIXU_EMBEDDING_BASE_URL=
ZHIXU_EMBEDDING_API_KEY=
ZHIXU_EMBEDDING_MODEL=
ZHIXU_EMBEDDING_DIMENSIONS=0
ZHIXU_EMBEDDING_NORMALIZATION=l2
ZHIXU_EMBEDDING_DISTANCE_METRIC=cosine
ZHIXU_EMBEDDING_MAX_BATCH_SIZE=128
ZHIXU_EMBEDDING_MAX_INPUT_BYTES=65536
ZHIXU_EMBEDDING_MAX_BATCH_INPUT_BYTES=8388608
ZHIXU_EMBEDDING_TIMEOUT=30s
ZHIXU_EMBEDDING_MAX_RESPONSE_BYTES=67108864
ZHIXU_RETRIEVAL_RRF_K=60
ZHIXU_RETRIEVAL_RRF_LEXICAL_CANDIDATE_LIMIT=200
ZHIXU_RETRIEVAL_RRF_VECTOR_CANDIDATE_LIMIT=200
ZHIXU_RETRIEVAL_RRF_FUSED_CANDIDATE_LIMIT=100
ZHIXU_RETRIEVAL_RRF_RERANK_CANDIDATE_LIMIT=50
ZHIXU_WORKER_SOFT_STOP_TIMEOUT=30s
ZHIXU_WORKER_HARD_STOP_TIMEOUT=60s
ZHIXU_WORKER_STOP_GRACE_PERIOD=70s
ZHIXU_TELEMETRY_MODE=disabled
# Set ZHIXU_TELEMETRY_MODE=optional|required before enabling this endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
