ZHIXU_VERSION=dev
ZHIXU_HTTP_PORT=8080
ZHIXU_POSTGRES_DB=zhixu
ZHIXU_POSTGRES_USER=zhixu
ZHIXU_POSTGRES_PASSWORD=zhixu_dev_only_change_me
ZHIXU_WORKSPACE_ROOT=../workspace
ZHIXU_HEALTH_INTERVAL=15s
ZHIXU_WORKER_HEALTH_ADDR=0.0.0.0:8081
ZHIXU_WORKER_QUEUE=workflow
ZHIXU_WORKER_MAX_WORKERS=4
ZHIXU_WORKER_JOB_TIMEOUT=15m
ZHIXU_WORKER_RESCUE_STUCK_AFTER=30m
ZHIXU_WORKFLOW_LEASE=2m
ZHIXU_WORKFLOW_HEARTBEAT=30s
ZHIXU_REINDEX_DISPATCH_POLL_INTERVAL=1s
ZHIXU_REINDEX_DISPATCH_BATCH_SIZE=10
ZHIXU_REINDEX_DISPATCH_ERROR_BACKOFF=5s
ZHIXU_REINDEX_LEASE_DURATION=2m
ZHIXU_REINDEX_HEARTBEAT_INTERVAL=30s
ZHIXU_WORKER_SOFT_STOP_TIMEOUT=30s
ZHIXU_WORKER_HARD_STOP_TIMEOUT=60s
ZHIXU_WORKER_STOP_GRACE_PERIOD=70s
ZHIXU_TELEMETRY_MODE=disabled
# Set ZHIXU_TELEMETRY_MODE=optional|required before enabling this endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
