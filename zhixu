  for name in "${APP_NETNS_CONTAINER}" "${WORKER_NETNS_CONTAINER}"; do
    if docker_container_exists "${name}"; then
      labels="$(docker inspect --type container --format '{{ index .Config.Labels "com.docker.compose.project" }}	{{ index .Config.Labels "com.docker.compose.service" }}' "${name}")" \
        || fail "could not inspect namespace anchor ${name}"
      [[ "${labels}" == "${NETNS_PROJECT_NAME}"$'\t'"${name#zhixu-}" ]] \
        || fail "refusing to manage foreign namespace anchor ${name}"
    fi
  done
  if docker_network_exists "${NETNS_NETWORK_NAME}"; then
    labels="$(docker network inspect --format '{{ index .Labels "com.docker.compose.project" }}	{{ index .Labels "com.docker.compose.network" }}' "${NETNS_NETWORK_NAME}")" \
      || fail "could not inspect namespace network ${NETNS_NETWORK_NAME}"
    [[ "${labels}" == "${NETNS_PROJECT_NAME}"$'\tdefault' ]] \
      || fail "refusing to manage foreign namespace network ${NETNS_NETWORK_NAME}"
  fi
  validate_netns_project_scope
