legacy_model_api_get() {
  local path=$1
  docker exec -i "${LEGACY_MODEL_CONTAINER}" /bin/bash -s -- "${path}" <<'BASH'
set -Eeuo pipefail

readonly path=$1
readonly max_bytes=1048576
[[ "${path}" == /api/version || "${path}" == /api/tags ]] || exit 1
exec 3<>/dev/tcp/127.0.0.1/11434
printf 'GET %s HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept: application/json\r\nConnection: close\r\n\r\n' "${path}" >&3
IFS= read -r status <&3
status="${status%$'\r'}"
[[ "${status}" == 'HTTP/1.1 200 OK' ]] || exit 1
content_type=""
content_length=""
transfer_encoding=""
header_count=0
while IFS= read -r header <&3; do
  header_count=$((header_count + 1))
  ((header_count <= 100)) || exit 1
  header="${header%$'\r'}"
  [[ -n "${header}" ]] || break
  case "${header,,}" in
    content-type:*)
      [[ -z "${content_type}" ]] || exit 1
      content_type="${header#*:}"
      content_type="${content_type# }"
      ;;
    content-length:*)
      [[ -z "${content_length}" ]] || exit 1
      content_length="${header#*:}"
      content_length="${content_length# }"
      ;;
    transfer-encoding:*)
      [[ -z "${transfer_encoding}" ]] || exit 1
      transfer_encoding="${header#*:}"
      transfer_encoding="${transfer_encoding# }"
      ;;
  esac
done
[[ "${content_type,,}" == application/json* ]] || exit 1
[[ -z "${content_length}" || -z "${transfer_encoding}" ]] || exit 1
if [[ -n "${content_length}" ]]; then
  [[ "${content_length}" =~ ^[1-9][0-9]*$ ]] || exit 1
  ((content_length <= max_bytes)) || exit 1
  head -c "${content_length}" <&3
elif [[ -n "${transfer_encoding}" ]]; then
  [[ "${transfer_encoding,,}" == chunked ]] || exit 1
  total_bytes=0
  while true; do
    IFS= read -r chunk_header <&3
    chunk_header="${chunk_header%$'\r'}"
    [[ "${chunk_header}" =~ ^[0-9A-Fa-f]{1,8}$ ]] || exit 1
    chunk_size=$((16#${chunk_header}))
    if ((chunk_size == 0)); then
      trailer_count=0
      while IFS= read -r trailer <&3; do
        trailer_count=$((trailer_count + 1))
        ((trailer_count <= 20)) || exit 1
        trailer="${trailer%$'\r'}"
        [[ -n "${trailer}" ]] || break
      done
      break
    fi
    total_bytes=$((total_bytes + chunk_size))
    ((total_bytes <= max_bytes)) || exit 1
    head -c "${chunk_size}" <&3
    IFS= read -r terminator <&3
    [[ "${terminator}" == $'\r' ]] || exit 1
  done
  ((total_bytes > 0)) || exit 1
else
  exit 1
fi
BASH
}

capture_legacy_model_snapshot() {
  local version_json tags_json
  version_json="$(legacy_model_api_get /api/version)" \
    || fail "legacy Ollama version endpoint is unavailable"
  tags_json="$(legacy_model_api_get /api/tags)" \
    || fail "legacy Ollama model inventory is unavailable"
  LEGACY_MIGRATION_SNAPSHOT_FILE="${STATE_DIR}/legacy-model-snapshot.$$"
  [[ ! -e "${LEGACY_MIGRATION_SNAPSHOT_FILE}" && ! -L "${LEGACY_MIGRATION_SNAPSHOT_FILE}" ]] \
    || fail "legacy model snapshot path already exists"
  (umask 077; : >"${LEGACY_MIGRATION_SNAPSHOT_FILE}") || fail "could not create legacy model snapshot"
  python3 - "${version_json}" "${tags_json}" >"${LEGACY_MIGRATION_SNAPSHOT_FILE}" <<'PY'
import json
import re
import sys

version = json.loads(sys.argv[1])
payload = json.loads(sys.argv[2])
if version != {"version": "0.9.6"}:
    raise SystemExit("legacy Ollama version is outside the migration allowlist")
if not isinstance(payload, dict) or set(payload) != {"models"} or not isinstance(payload["models"], list):
    raise SystemExit("legacy model inventory shape is invalid")
models = {}
for model in payload["models"]:
    if not isinstance(model, dict):
        raise SystemExit("legacy model inventory entry is invalid")
    name = model.get("name")
    if model.get("model") not in (None, name):
        raise SystemExit("legacy model inventory aliases disagree")
    digest = model.get("digest")
    size = model.get("size")
    if (
        not isinstance(name, str)
        or re.fullmatch(r"[A-Za-z0-9._/-]+:[A-Za-z0-9._-]+", name) is None
        or not isinstance(digest, str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", digest) is None
        or not isinstance(size, int)
        or isinstance(size, bool)
        or size < 0
        or name in models
    ):
        raise SystemExit("legacy model inventory entry is invalid")
    models[name] = (digest, size)
required = {"qwen2.5:0.5b", "all-minilm:latest"}
if not required.issubset(models):
    raise SystemExit("legacy inventory lacks approved production probe models")
if not models or len(models) > 128:
    raise SystemExit("legacy model inventory size is invalid")
for name in sorted(models):
    digest, size = models[name]
    print(f"{name}\t{digest}\t{size}")
PY
  validate_protected_file "${LEGACY_MIGRATION_SNAPSHOT_FILE}" "legacy model snapshot"
}

