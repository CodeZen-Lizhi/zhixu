helper_stack_matches() {
  local port=$1 app_image_id worker_image_id
  docker_container_exists "${APP_NETNS_CONTAINER}" && docker_container_exists "${WORKER_NETNS_CONTAINER}" \
    && docker_network_exists "${NETNS_NETWORK_NAME}" || return 1
  app_image_id="$(docker image inspect --format '{{.Id}}' "${APP_NETNS_IMAGE}" 2>/dev/null)" || return 1
  worker_image_id="$(docker image inspect --format '{{.Id}}' "${WORKER_NETNS_IMAGE}" 2>/dev/null)" || return 1
  docker network inspect "${NETNS_NETWORK_NAME}" | python3 -c '
import json
import sys

items = json.load(sys.stdin)
if not isinstance(items, list) or len(items) != 1:
    raise SystemExit(1)
network = items[0]
labels = network.get("Labels") or {}
if (
    network.get("Name") != "zhixu-runtime"
    or network.get("Driver") != "bridge"
    or network.get("Scope") != "local"
    or network.get("Internal") is not False
    or network.get("Attachable") is not False
    or network.get("Ingress") is not False
    or network.get("EnableIPv6") is not False
    or labels.get("com.docker.compose.project") != "zhixu-netns"
    or labels.get("com.docker.compose.network") != "default"
):
    raise SystemExit(1)
' || return 1
  docker inspect "${APP_NETNS_CONTAINER}" "${WORKER_NETNS_CONTAINER}" | python3 -c '
import json
import sys

port = str(int(sys.argv[1]))
app_image_id = sys.argv[2]
worker_image_id = sys.argv[3]
items = json.load(sys.stdin)
if not isinstance(items, list) or len(items) != 2:
    raise SystemExit(1)
by_name = {item.get("Name", "").lstrip("/"): item for item in items}
app = by_name.get("zhixu-app-netns")
worker = by_name.get("zhixu-worker-netns")
if app is None or worker is None:
    raise SystemExit(1)

def labels(item):
    return item.get("Config", {}).get("Labels") or {}

def common(item, service, user, entrypoint):
    cfg = item.get("Config", {})
    host = item.get("HostConfig", {})
    state = item.get("State", {})
    if labels(item).get("com.docker.compose.project") != "zhixu-netns":
        return False
    if labels(item).get("com.docker.compose.service") != service:
        return False
    if state.get("Status") != "running" or (state.get("Health") or {}).get("Status") != "healthy":
        return False
    if cfg.get("User") != user or cfg.get("Entrypoint") != entrypoint:
        return False
    if host.get("NetworkMode") != "zhixu-runtime":
        return False
    if host.get("Privileged") is not False or host.get("ReadonlyRootfs") is not True:
        return False
    if (host.get("SecurityOpt") or []) != ["no-new-privileges:true"]:
        return False
    if sorted(host.get("CapDrop") or []) != ["ALL"] or (host.get("Binds") or []) or (item.get("Mounts") or []):
        return False
    if host.get("RestartPolicy") != {"Name": "unless-stopped", "MaximumRetryCount": 0}:
        return False
    if (host.get("ExtraHosts") or []) != ["host.docker.internal:host-gateway"]:
        return False
    networks = (item.get("NetworkSettings") or {}).get("Networks") or {}
    if set(networks) != {"zhixu-runtime"}:
        return False
    for value in cfg.get("Env") or []:
        key = value.split("=", 1)[0]
        if key.startswith(("ZHIXU_DATABASE", "ZHIXU_MODEL", "ZHIXU_AUTH", "ZHIXU_WORKSPACE", "POSTGRES", "OLLAMA")):
            return False
    return True

if not common(app, "app-netns", "0:0", ["/app/netns-ingress.sh"]):
    raise SystemExit(1)
if not common(worker, "worker-netns", "10001:10001", ["/app/netns-ingress.sh", "--worker-sentinel"]):
    raise SystemExit(1)
if app.get("Image") != app_image_id or worker.get("Image") != worker_image_id:
    raise SystemExit(1)
app_host = app.get("HostConfig") or {}
worker_host = worker.get("HostConfig") or {}
if (app_host.get("PortBindings") or {}) != {
    "8080/tcp": [{"HostIp": "127.0.0.1", "HostPort": port}],
}:
    raise SystemExit(1)
if worker_host.get("PortBindings") or {}:
    raise SystemExit(1)
if app_host.get("Tmpfs") != {"/run": "rw,noexec,nosuid,size=65536"} or worker_host.get("Tmpfs"):
    raise SystemExit(1)
app_caps = {value.removeprefix("CAP_") for value in (app_host.get("CapAdd") or [])}
if app_caps != {"NET_ADMIN", "SETGID", "SETUID"}:
    raise SystemExit(1)
if worker_host.get("CapAdd"):
    raise SystemExit(1)

def healthcheck(item, expected_test):
    configured = (item.get("Config") or {}).get("Healthcheck") or {}
    return (
        configured.get("Test") == expected_test
        and configured.get("Interval") == 5000000000
        and configured.get("Timeout") == 3000000000
        and configured.get("Retries") == 20
    )

if not healthcheck(app, ["CMD-SHELL", "ss -H -ltn '\''sport = :8080'\'' | grep -q '\''0.0.0.0:8080'\''"]):
    raise SystemExit(1)
if not healthcheck(worker, ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:18082"]):
    raise SystemExit(1)
' "${port}" "${app_image_id}" "${worker_image_id}"
}

helper_uses_port() {
  local port=$1
  docker_container_exists "${APP_NETNS_CONTAINER}" || return 1
  docker inspect "${APP_NETNS_CONTAINER}" | python3 -c '
import json
import sys
items = json.load(sys.stdin)
if not isinstance(items, list) or len(items) != 1:
    raise SystemExit(1)
bindings = ((items[0].get("HostConfig") or {}).get("PortBindings") or {}).get("8080/tcp") or []
if bindings != [{"HostIp": "127.0.0.1", "HostPort": str(int(sys.argv[1]))}]:
