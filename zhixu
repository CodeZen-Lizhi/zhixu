main_project_container_ids() {
  docker ps --all --quiet --filter "label=com.docker.compose.project=${PROJECT_NAME}" 2>/dev/null || true
}

validate_main_project_containers() {
  local ids=$1 id service
  [[ -z "${ids}" ]] && return 0
  while read -r id; do
    [[ -n "${id}" ]] || continue
    service="$(docker inspect --type container --format '{{ index .Config.Labels "com.docker.compose.service" }}' "${id}")" \
      || fail "could not inspect main Compose container"
    case "${service}" in
      postgres|model-settings-key-init|migrate|modelctl|local-model-volume-init|local-model-runtime-credential-init|local-model-runtime|app|worker|app-model-relay|worker-model-relay|proxy|firewall) ;;
      *) fail "refusing to remove unknown zhixu Compose service ${service}" ;;
    esac
  done <<<"${ids}"
}

validate_netns_project_containers() {
  local ids=$1 id identity
  [[ -z "${ids}" ]] && return 0
  while read -r id; do
    [[ -n "${id}" ]] || continue
    identity="$(docker inspect --type container --format '{{.Name}}\t{{ index .Config.Labels "com.docker.compose.service" }}' "${id}")" \
      || fail "could not inspect namespace helper container"
    case "${identity}" in
      "/${APP_NETNS_CONTAINER}"'\tapp-netns'|"/${WORKER_NETNS_CONTAINER}"'\tworker-netns') ;;
      *) fail "refusing to remove unknown zhixu-netns Compose container ${identity}" ;;
    esac
  done <<<"${ids}"
}

validate_netns_project_scope() {
  local ids networks network identity
  ids="$(docker ps --all --quiet --filter "label=com.docker.compose.project=${NETNS_PROJECT_NAME}")" \
    || fail "could not list namespace helper containers"
  validate_netns_project_containers "${ids}"
  networks="$(docker network ls --quiet --filter "label=com.docker.compose.project=${NETNS_PROJECT_NAME}")" \
    || fail "could not list namespace helper networks"
  while read -r network; do
    [[ -n "${network}" ]] || continue
    identity="$(docker network inspect --format '{{.Name}}\t{{ index .Labels "com.docker.compose.project" }}\t{{ index .Labels "com.docker.compose.network" }}' "${network}")" \
      || fail "could not inspect namespace helper network"
    [[ "${identity}" == "${NETNS_NETWORK_NAME}"'\t'"${NETNS_PROJECT_NAME}"'\tdefault' ]] \
      || fail "refusing to manage unknown zhixu-netns Compose network"
  done <<<"${networks}"
}

remove_project_containers() {
  local project=$1 ids id
  ids="$(docker ps --all --quiet --filter "label=com.docker.compose.project=${project}" 2>/dev/null || true)"
  [[ -z "${ids}" ]] && return 0
  if [[ "${project}" == "${PROJECT_NAME}" ]]; then
    validate_main_project_containers "${ids}"
  elif [[ "${project}" == "${NETNS_PROJECT_NAME}" ]]; then
    validate_netns_project_containers "${ids}"
  fi
  while read -r id; do
    [[ -n "${id}" ]] || continue
    docker stop --time 90 "${id}" >/dev/null 2>&1 || true
  done <<<"${ids}"
  while read -r id; do
    [[ -n "${id}" ]] || continue
    docker rm --force "${id}" >/dev/null || fail "could not remove ${project} Compose container"
  done <<<"${ids}"
}

remove_project_networks() {
  local project=$1 networks network labels network_name endpoint_count
  networks="$(docker network ls --quiet --filter "label=com.docker.compose.project=${project}" 2>/dev/null || true)"
  [[ -z "${networks}" ]] && return 0
  while read -r network; do
    [[ -n "${network}" ]] || continue
    labels="$(docker network inspect --format '{{ index .Labels "com.docker.compose.project" }}	{{ index .Labels "com.docker.compose.network" }}' "${network}")" \
      || fail "could not inspect ${project} Compose network"
    if [[ "${project}" == "${NETNS_PROJECT_NAME}" ]]; then
      network_name="$(docker network inspect --format '{{.Name}}' "${network}")" \
        || fail "could not inspect ${project} Compose network name"
      [[ "${network_name}" == "${NETNS_NETWORK_NAME}" && "${labels}" == "${NETNS_PROJECT_NAME}"$'\tdefault' ]] \
        || fail "refusing to remove unknown zhixu-netns Compose network"
    else
      [[ "${labels}" == "${project}"$'\t'* ]] || fail "refusing to remove foreign ${project} Compose network"
    fi
    endpoint_count="$(docker network inspect --format '{{ len .Containers }}' "${network}")" \
      || fail "could not inspect ${project} Compose network endpoints"
    [[ "${endpoint_count}" == "0" ]] || fail "${project} Compose network still has endpoints"
    docker network rm "${network}" >/dev/null || fail "could not remove ${project} Compose network"
  done <<<"${networks}"
}

docker_volume_exists() {
  docker volume inspect "$1" >/dev/null 2>&1
}

validate_main_project_volumes() {
  local key name identity names ownership
  for key in zhixu-postgres zhixu-model-secrets zhixu-local-models zhixu-local-model-runtime-credentials; do
    name="${PROJECT_NAME}_${key}"
    if docker_volume_exists "${name}"; then
      identity="$(docker volume inspect --format '{{.Name}}	{{ index .Labels "com.docker.compose.project" }}	{{ index .Labels "com.docker.compose.volume" }}' "${name}")" \
        || fail "could not inspect ${name}"
      [[ "${identity}" == "${name}"$'\t'"${PROJECT_NAME}"$'\t'"${key}" ]] \
        || fail "refusing to remove foreign Compose volume ${name}"
      case "${key}" in
        zhixu-local-models)
          ownership="$(docker volume inspect --format '{{ index .Labels "com.zhixu.owner" }}	{{ index .Labels "com.zhixu.schema" }}' "${name}")" \
            || fail "could not inspect ${name} ownership"
          [[ "${ownership}" == 'local-model-runtime'$'\t''local-model-store/v1' ]] \
            || fail "refusing to remove foreign managed model volume ${name}"
          ;;
        zhixu-local-model-runtime-credentials)
          ownership="$(docker volume inspect --format '{{ index .Labels "com.zhixu.owner" }}	{{ index .Labels "com.zhixu.schema" }}' "${name}")" \
            || fail "could not inspect ${name} ownership"
          [[ "${ownership}" == 'local-model-runtime'$'\t''local-model-runtime-credentials/v1' ]] \
            || fail "refusing to remove foreign runtime credential volume ${name}"
          ;;
      esac
    fi
  done
  names="$(docker volume ls --quiet --filter "label=com.docker.compose.project=${PROJECT_NAME}")" \
    || fail "could not list ${PROJECT_NAME} Compose volumes"
  while read -r name; do
    [[ -n "${name}" ]] || continue
    identity="$(docker volume inspect --format '{{.Name}}	{{ index .Labels "com.docker.compose.project" }}	{{ index .Labels "com.docker.compose.volume" }}' "${name}")" \
      || fail "could not inspect ${PROJECT_NAME} Compose volume"
    case "${identity}" in
      "${PROJECT_NAME}_zhixu-postgres"$'\t'"${PROJECT_NAME}"$'\t''zhixu-postgres'|\
      "${PROJECT_NAME}_zhixu-model-secrets"$'\t'"${PROJECT_NAME}"$'\t''zhixu-model-secrets'|\
      "${PROJECT_NAME}_zhixu-local-models"$'\t'"${PROJECT_NAME}"$'\t''zhixu-local-models'|\
      "${PROJECT_NAME}_zhixu-local-model-runtime-credentials"$'\t'"${PROJECT_NAME}"$'\t''zhixu-local-model-runtime-credentials') ;;
      *) fail "refusing to remove unknown ${PROJECT_NAME} Compose volume ${name}" ;;
    esac
  done <<<"${names}"
}

remove_main_project_volumes() {
  local names name
  validate_main_project_volumes
  names="$(docker volume ls --quiet --filter "label=com.docker.compose.project=${PROJECT_NAME}")" \
    || fail "could not list ${PROJECT_NAME} Compose volumes"
  while read -r name; do
    [[ -n "${name}" ]] || continue
    docker volume rm "${name}" >/dev/null || fail "could not remove ${PROJECT_NAME} Compose volume ${name}"
  done <<<"${names}"
  for name in "${PROJECT_NAME}_zhixu-postgres" "${PROJECT_NAME}_zhixu-model-secrets" "${PROJECT_NAME}_zhixu-local-models" "${PROJECT_NAME}_zhixu-local-model-runtime-credentials"; do
    docker_volume_exists "${name}" && fail "${PROJECT_NAME} Compose volume ${name} still exists"
  done
  return 0
}

teardown_main_project() {
  local ids
  ids="$(main_project_container_ids)"
  validate_main_project_containers "${ids}"
  compose_without_grant --profile workspace-runtime down --remove-orphans >/dev/null 2>&1 || true
  remove_project_containers "${PROJECT_NAME}"
  remove_project_networks "${PROJECT_NAME}"
}

teardown_netns_project() {
  validate_netns_resource_ownership
  netns_compose down --remove-orphans >/dev/null 2>&1 || true
  remove_project_containers "${NETNS_PROJECT_NAME}"
  remove_project_networks "${NETNS_PROJECT_NAME}"
}

ensure_netns_stack() {
  local port=$1
  validate_netns_resource_ownership
  netns_compose build app-netns worker-netns
  if helper_stack_matches "${port}" && validate_netns_runtime_security; then
    if netns_compose up --detach --no-recreate --wait app-netns worker-netns >/dev/null \
      && helper_stack_matches "${port}" && validate_netns_runtime_security; then
      return
    fi
  fi
  if docker_container_exists "${APP_NETNS_CONTAINER}" && ! helper_uses_port "${port}"; then
    ensure_http_port_available
  fi
  log "rebuilding launcher-owned namespace anchors"
  teardown_main_project
  teardown_netns_project
  ensure_http_port_available
  netns_compose up --detach --wait app-netns worker-netns >/dev/null
  helper_stack_matches "${port}" || fail "namespace helper did not become ready"
  validate_netns_runtime_security || fail "namespace anchor runtime security is invalid"
}

contain_uncommitted_runtime() {
  printf '[zhixu] warning: stopping the uncommitted Workspace runtime\n' >&2
  compose_without_grant --profile workspace-runtime stop \
    app-model-relay worker-model-relay app worker >/dev/null 2>&1 || true
  compose_without_grant --profile workspace-runtime rm --force --stop \
    app-model-relay worker-model-relay app worker >/dev/null 2>&1 || true
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    if protected_file_is_valid "${GRANT_OVERRIDE}"; then
      rm -f -- "${GRANT_OVERRIDE}" || true
    else
      printf '[zhixu] warning: unsafe Workspace grant was retained for diagnosis\n' >&2
    fi
  fi
}

validate_compose() {
  compose_without_grant --profile workspace-runtime config --quiet
  local steady_model=(docker compose --profile workspace-runtime --project-name "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file "${ENV_FILE}" config --format json)
  python3 "${SCRIPT_DIR}/deploy/compose_auth_check.py" -- "${steady_model[@]}"
