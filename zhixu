verify_legacy_model_copy() {
  local image_id=$1 fingerprint=$2 snapshot_digest=$3 snapshot_base64=$4
  LEGACY_MIGRATION_VERIFY_FILE="${STATE_DIR}/legacy-model-verify.$$"
  [[ ! -e "${LEGACY_MIGRATION_VERIFY_FILE}" && ! -L "${LEGACY_MIGRATION_VERIFY_FILE}" ]] \
    || fail "legacy model verification path already exists"
  (umask 077; : >"${LEGACY_MIGRATION_VERIFY_FILE}") || fail "could not create legacy model verification state"
  run_mutation_command docker run --rm --network none --read-only --user 10001:10001 --cap-drop ALL \
    --security-opt no-new-privileges \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m,mode=1777 \
    --mount "type=volume,src=${MANAGED_MODEL_VOLUME},dst=/var/lib/zhixu/ollama/.ollama" \
    --entrypoint "${LEGACY_MIGRATION_HELPER}" "${image_id}" verify \
    "${fingerprint}" "${image_id}" "${snapshot_digest}" "${snapshot_base64}" \
    >"${LEGACY_MIGRATION_VERIFY_FILE}" \
    || fail "copied model store failed target-version verification"
  validate_protected_file "${LEGACY_MIGRATION_VERIFY_FILE}" "legacy model verification state"
  python3 - "${LEGACY_MIGRATION_SNAPSHOT_FILE}" "${LEGACY_MIGRATION_VERIFY_FILE}" <<'PY'
import base64
import json
import math
import re
import sys

with open(sys.argv[1], "r", encoding="ascii") as source:
    expected = [tuple(line.rstrip("\n").split("\t")) for line in source]
values = {}
with open(sys.argv[2], "r", encoding="ascii") as source:
    for line in source:
        key, separator, encoded = line.rstrip("\n").partition("=")
        if not separator or key not in {"version_base64", "tags_base64", "chat_base64", "embedding_base64"} or key in values:
            raise SystemExit("target verification output is invalid")
        if len(encoded) > 24_000_000 or re.fullmatch(r"[A-Za-z0-9+/]*={0,2}", encoded) is None:
            raise SystemExit("target verification output is invalid")
        values[key] = json.loads(base64.b64decode(encoded, validate=True))
if set(values) != {"version_base64", "tags_base64", "chat_base64", "embedding_base64"}:
    raise SystemExit("target verification output is incomplete")
if values["version_base64"] != {"version": "0.32.9"}:
    raise SystemExit("target Ollama version is not the approved compatibility pin")

tags = values["tags_base64"]
if not isinstance(tags, dict) or not isinstance(tags.get("models"), list):
    raise SystemExit("target model inventory is invalid")
actual = []
for model in tags["models"]:
    name = model.get("name") if isinstance(model, dict) else None
    digest = model.get("digest") if isinstance(model, dict) else None
    size = model.get("size") if isinstance(model, dict) else None
    if model.get("model") not in (None, name) or not isinstance(size, int) or isinstance(size, bool):
        raise SystemExit("target model inventory is invalid")
    actual.append((name, digest, str(size)))
if sorted(actual) != expected:
    raise SystemExit("target model inventory differs from the legacy snapshot")

chat = values["chat_base64"]
try:
    content = chat["choices"][0]["message"]["content"]
except (KeyError, IndexError, TypeError):
    raise SystemExit("target Chat production probe response is invalid")
if chat.get("model") not in {"qwen2.5:0.5b", "qwen2.5:0.5b:latest"} or not isinstance(content, str) or not content.strip():
    raise SystemExit("target Chat production probe response is invalid")

embedding = values["embedding_base64"]
vectors = embedding.get("embeddings") if isinstance(embedding, dict) else None
if embedding.get("model") != "all-minilm:latest" or not isinstance(vectors, list) or len(vectors) != 1 or not vectors[0]:
    raise SystemExit("target Embedding production probe response is invalid")
if any(isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) for value in vectors[0]):
    raise SystemExit("target Embedding production probe response is invalid")
PY
}

