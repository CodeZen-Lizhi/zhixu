}

start_base_stack() {
  log "building base and Workspace runtime images"
  bootstrap_compose --profile workspace-runtime --profile modelctl build \
    model-settings-key-init migrate local-model-runtime-credential-init local-model-volume-init modelctl
  compose_without_grant --profile workspace-runtime build \
    local-model-runtime app worker app-model-relay worker-model-relay
  log "starting PostgreSQL, secret initialization, and migrations"
  compose_without_grant --profile workspace-runtime up --detach --wait --remove-orphans postgres
  bootstrap_compose run --rm --no-deps -T model-settings-key-init
  bootstrap_compose run --rm --no-deps -T migrate
  bootstrap_compose --profile workspace-runtime run --rm --no-deps -T local-model-runtime-credential-init
  bootstrap_compose --profile workspace-runtime run --rm --no-deps -T local-model-volume-init
  compose_without_grant --profile workspace-runtime up --detach --wait local-model-runtime
  bootstrap_compose --profile modelctl run --rm --no-deps -T modelctl recover --stale
