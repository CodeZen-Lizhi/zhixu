  python3 "${SCRIPT_DIR}/deploy/compose_workspace_check.py" --base -- "${steady_model[@]}"
  bootstrap_compose --profile workspace-runtime --profile modelctl config --quiet
  local bootstrap_model=(docker compose --profile workspace-runtime --profile modelctl --project-name "${PROJECT_NAME}" -f "${COMPOSE_FILE}" -f "${BOOTSTRAP_COMPOSE_FILE}" --env-file "${ENV_FILE}" config --format json)
  python3 "${SCRIPT_DIR}/deploy/compose_auth_check.py" --bootstrap -- "${bootstrap_model[@]}"
  python3 "${SCRIPT_DIR}/deploy/compose_runtime_check.py" --bootstrap -- "${bootstrap_model[@]}"
  python3 "${SCRIPT_DIR}/deploy/compose_workspace_check.py" --base -- "${bootstrap_model[@]}"
  local static_model=(docker compose --profile workspace-runtime --project-name "${PROJECT_NAME}" -f "${COMPOSE_FILE}" -f "${SCRIPT_DIR}/deploy/compose.static-models.yml" --env-file "${ENV_FILE}" config --format json)
