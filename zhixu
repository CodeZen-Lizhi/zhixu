#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly COMPOSE_FILE="${SCRIPT_DIR}/deploy/compose.yml"
readonly DOCKERFILE="${SCRIPT_DIR}/deploy/Dockerfile"
readonly ENV_TEMPLATE="${SCRIPT_DIR}/.env.example"
readonly LOCAL_ENV_FILE="${SCRIPT_DIR}/.env"
readonly PROJECT_NAME="zhixu"
readonly STATE_DIR="${SCRIPT_DIR}/.zhixu"
readonly LOCK_DIR="${STATE_DIR}/launcher.lock"
readonly LOCK_METADATA="${LOCK_DIR}/owner"
readonly BUNDLE_DIR="${STATE_DIR}/bundle"
readonly CONTROLLER_BINARY="${BUNDLE_DIR}/zhixu-host-controller"
readonly CONTROLLER_ASSETS="${BUNDLE_DIR}/web"
readonly CONTROLLER_PID_FILE="${STATE_DIR}/controller.pid"
readonly CONTROLLER_LOG_FILE="${STATE_DIR}/controller.log"
readonly GRANT_OVERRIDE="${STATE_DIR}/workspace-grant.yml"

ENV_FILE="${LOCAL_ENV_FILE}"
MUTATION_LOCK_HELD=0
MUTATION_COMMAND_PID=""

log() {
  printf '[zhixu] %s\n' "$1"
}

fail() {
  printf '[zhixu] failed: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: ./zhixu <command> [arguments]

Commands:
  up                       Start base services and the native Host Controller
  restart                  Restart services and restore the saved exact Workspace
  status                   Show Controller and Compose process status
  logs [controller|service] Follow Controller or one known Compose service
  down                     Stop Controller and Compose while preserving volumes
  reset [--confirm DELETE] Delete PostgreSQL/model-secret volumes and the active grant
  help                     Show this help
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

validate_project_scope() {
  if [[ -n "${ZHIXU_COMPOSE_PROJECT_NAME:-}" && "${ZHIXU_COMPOSE_PROJECT_NAME}" != "${PROJECT_NAME}" ]]; then
    fail "ZHIXU_COMPOSE_PROJECT_NAME cannot override the fixed Compose project zhixu"
  fi
}

path_owner() {
  local value
  if value="$(stat -f '%u' -- "$1" 2>/dev/null)" && [[ "${value}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${value}"
    return
  fi
  stat -c '%u' -- "$1" 2>/dev/null || return 1
}

path_mode() {
  local value
  if value="$(stat -f '%Lp' -- "$1" 2>/dev/null)" && [[ "${value}" =~ ^[0-7]+$ ]]; then
    printf '%s\n' "${value}"
    return
  fi
  stat -c '%a' -- "$1" 2>/dev/null || return 1
}

validate_state_directory() {
  [[ -d "${STATE_DIR}" && ! -L "${STATE_DIR}" ]] || fail ".zhixu must be a regular directory, not a symlink"
  [[ "$(path_owner "${STATE_DIR}")" == "$(id -u)" ]] || fail ".zhixu has an unexpected owner"
  local mode="$(path_mode "${STATE_DIR}")"
  [[ "${mode}" == "700" ]] || fail ".zhixu permissions must be 0700"
}

ensure_state_directory() {
  if [[ ! -e "${STATE_DIR}" && ! -L "${STATE_DIR}" ]]; then
    (umask 077; mkdir -- "${STATE_DIR}") || fail "could not create protected Controller state"
  fi
  validate_state_directory
}

validate_optional_state_directory() {
  if [[ -e "${STATE_DIR}" || -L "${STATE_DIR}" ]]; then
    validate_state_directory
  fi
}

validate_protected_file() {
  local path=$1 label=$2 mode
  [[ -f "${path}" && ! -L "${path}" ]] || fail "${label} must be a regular file, not a symlink"
  [[ "$(path_owner "${path}")" == "$(id -u)" ]] || fail "${label} has an unexpected owner"
  mode="$(path_mode "${path}")" || fail "could not inspect ${label} permissions"
  [[ "${mode}" == "600" ]] || fail "${label} permissions must be 0600"
}

select_existing_env() {
  if [[ -e "${LOCAL_ENV_FILE}" || -L "${LOCAL_ENV_FILE}" ]]; then
    validate_protected_file "${LOCAL_ENV_FILE}" ".env"
    ENV_FILE="${LOCAL_ENV_FILE}"
  else
    ENV_FILE="${ENV_TEMPLATE}"
  fi
}

initialize_local_state() {
  ensure_state_directory
  if [[ ! -e "${LOCAL_ENV_FILE}" && ! -L "${LOCAL_ENV_FILE}" ]]; then
    (umask 077; cp -- "${ENV_TEMPLATE}" "${LOCAL_ENV_FILE}") || fail "could not create local .env"
    log "created local .env from .env.example"
  else
    validate_protected_file "${LOCAL_ENV_FILE}" ".env"
  fi
  chmod 0600 "${LOCAL_ENV_FILE}"
  validate_protected_file "${LOCAL_ENV_FILE}" ".env"
  ENV_FILE="${LOCAL_ENV_FILE}"
  if awk -F= '$1 == "ZHIXU_WORKSPACE_ROOT" && $2 != "" { found = 1 } END { exit found ? 0 : 1 }' "${ENV_FILE}"; then
    log "warning: ZHIXU_WORKSPACE_ROOT is obsolete and will not be mounted; select the directory in the browser"
  fi
}

ensure_empty_grant_override() {
  if [[ ! -e "${GRANT_OVERRIDE}" && ! -L "${GRANT_OVERRIDE}" ]]; then
    (umask 077; printf 'services: {}\n' >"${GRANT_OVERRIDE}") || fail "could not create empty Workspace grant file"
  fi
  validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
}

release_mutation_lock() {
  if [[ "${MUTATION_LOCK_HELD}" -eq 1 ]]; then
    if ! rm -f -- "${LOCK_METADATA}" || ! rmdir -- "${LOCK_DIR}"; then
      printf '[zhixu] warning: could not release launcher lock %s\n' "${LOCK_DIR}" >&2
    fi
    MUTATION_LOCK_HELD=0
  fi
  return 0
}

read_lock_metadata() {
  awk -F= '
    NR == 1 && NF == 2 && $1 == "pid" && $2 ~ /^[1-9][0-9]*$/ { pid = $2; next }
    NR == 2 && NF == 2 && $1 == "command" && $2 ~ /^(up|restart|down|reset)$/ { command = $2; next }
    { invalid = 1 }
    END { if (!invalid && NR == 2 && pid != "" && command != "") print pid, command; else exit 1 }
  ' "${LOCK_METADATA}"
}

acquire_mutation_lock() {
  local command=$1 metadata owner_pid owner_command stale
  if mkdir -m 0700 -- "${LOCK_DIR}" 2>/dev/null; then
    MUTATION_LOCK_HELD=1
    (umask 077; printf 'pid=%s\ncommand=%s\n' "$$" "${command}" >"${LOCK_METADATA}") || fail "could not write launcher lock"
    return
  fi
  [[ -d "${LOCK_DIR}" && ! -L "${LOCK_DIR}" ]] || fail "launcher lock is unsafe"
  validate_protected_file "${LOCK_METADATA}" "launcher lock metadata"
  metadata="$(read_lock_metadata)" || fail "launcher lock metadata is invalid"
  read -r owner_pid owner_command <<<"${metadata}"
  if kill -0 "${owner_pid}" 2>/dev/null; then
    fail "another mutating command is running (pid=${owner_pid}, command=${owner_command})"
  fi
  local ps_output
  if ps_output="$(ps -p "${owner_pid}" -o pid= 2>&1)"; then
    fail "launcher lock owner is still present (pid=${owner_pid}, command=${owner_command})"
  elif [[ -n "${ps_output}" ]]; then
    fail "could not prove launcher lock owner is absent"
  fi
  stale="${STATE_DIR}/launcher.lock.stale.$$"
  [[ ! -e "${stale}" && ! -L "${stale}" ]] || fail "stale lock recovery path already exists"
  mv -- "${LOCK_DIR}" "${stale}" || fail "launcher lock changed during recovery"
  rm -f -- "${stale}/owner"
  rmdir -- "${stale}" || fail "could not remove stale launcher lock"
  mkdir -m 0700 -- "${LOCK_DIR}" || fail "could not acquire launcher lock"
  MUTATION_LOCK_HELD=1
  (umask 077; printf 'pid=%s\ncommand=%s\n' "$$" "${command}" >"${LOCK_METADATA}") || fail "could not write launcher lock"
  log "recovered stale ${owner_command} lock from pid ${owner_pid}"
}

forward_mutation_signal() {
  local signal=$1 exit_code=$2
  trap - INT TERM
  if [[ -n "${MUTATION_COMMAND_PID}" ]]; then
    kill -"${signal}" -- "-${MUTATION_COMMAND_PID}" 2>/dev/null || kill -"${signal}" "${MUTATION_COMMAND_PID}" 2>/dev/null || true
    wait "${MUTATION_COMMAND_PID}" 2>/dev/null || true
  fi
  exit "${exit_code}"
}

run_mutation_command() {
  local exit_code=0
  python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@" &
  MUTATION_COMMAND_PID=$!
  wait "${MUTATION_COMMAND_PID}" || exit_code=$?
  MUTATION_COMMAND_PID=""
  return "${exit_code}"
}

run_with_mutation_lock() {
  local command=$1 operation=$2
  shift 2
  require_command python3
  ensure_state_directory
  trap release_mutation_lock EXIT
  trap 'forward_mutation_signal INT 130' INT
  trap 'forward_mutation_signal TERM 143' TERM
  acquire_mutation_lock "${command}"
  "${operation}" "$@"
  release_mutation_lock
  trap - EXIT INT TERM
}

compose() {
  local compose_files=(-f "${COMPOSE_FILE}")
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
    compose_files+=(-f "${GRANT_OVERRIDE}")
  fi
  local prefix=(docker compose --project-name "${PROJECT_NAME}" "${compose_files[@]}" --env-file "${ENV_FILE}")
  if [[ "${MUTATION_LOCK_HELD}" -eq 1 ]]; then
    ZHIXU_MODEL_SETTINGS_ROLLOUT_ID= ZHIXU_MODEL_SETTINGS_PREPARED=false ZHIXU_WORKER_RESTART_POLICY=on-failure \
      run_mutation_command "${prefix[@]}" "$@"
  else
    ZHIXU_MODEL_SETTINGS_ROLLOUT_ID= ZHIXU_MODEL_SETTINGS_PREPARED=false ZHIXU_WORKER_RESTART_POLICY=on-failure \
      "${prefix[@]}" "$@"
  fi
}

validate_compose() {
  compose config --quiet
  local model=(docker compose --profile workspace-runtime --profile modelctl --project-name "${PROJECT_NAME}" -f "${COMPOSE_FILE}" --env-file "${ENV_FILE}" config --format json)
  python3 "${SCRIPT_DIR}/deploy/compose_auth_check.py" -- "${model[@]}"
  python3 "${SCRIPT_DIR}/deploy/compose_runtime_check.py" -- "${model[@]}"
  python3 "${SCRIPT_DIR}/deploy/compose_workspace_check.py" --base -- "${model[@]}"
  local static_model=(docker compose --profile workspace-runtime --project-name "${PROJECT_NAME}" -f "${COMPOSE_FILE}" -f "${SCRIPT_DIR}/deploy/compose.static-models.yml" --env-file "${ENV_FILE}" config --format json)
  python3 "${SCRIPT_DIR}/deploy/compose_runtime_check.py" --legacy-model-env -- "${static_model[@]}"
}

start_base_stack() {
  log "building base and Workspace runtime images"
  compose --profile workspace-runtime --profile modelctl build \
    model-settings-key-init migrate modelctl app worker app-model-relay worker-model-relay firewall proxy
  log "starting PostgreSQL, secret initialization, and migrations"
  compose up --detach --wait postgres
  compose run --rm --no-deps -T model-settings-key-init
  compose run --rm --no-deps -T migrate
  compose --profile modelctl run --rm --no-deps -T modelctl recover --stale
}

host_platform() {
  local os_name architecture
  case "$(uname -s)" in
    Darwin) os_name=darwin ;;
    Linux) os_name=linux ;;
    *) fail "Host Controller supports only macOS and Linux" ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) architecture=amd64 ;;
    arm64|aarch64) architecture=arm64 ;;
    *) fail "Host Controller supports only amd64 and arm64" ;;
  esac
  printf '%s %s\n' "${os_name}" "${architecture}"
}

remove_bundle_directory() {
  [[ -d "${BUNDLE_DIR}" && ! -L "${BUNDLE_DIR}" ]] || fail "Controller bundle path is unsafe"
  find "${BUNDLE_DIR}" -depth -mindepth 1 -delete || fail "could not replace Controller bundle"
  rmdir -- "${BUNDLE_DIR}" || fail "could not replace Controller bundle"
}

build_controller_bundle() {
  local host_os host_arch temporary
  read -r host_os host_arch <<<"$(host_platform)"
  temporary="${STATE_DIR}/bundle.new.$$"
  [[ ! -e "${temporary}" && ! -L "${temporary}" ]] || fail "Controller bundle staging path already exists"
  mkdir -m 0700 -- "${temporary}" || fail "could not stage Controller bundle"
  log "building native Host Controller and web bundle"
  if ! run_mutation_command docker buildx build --target host-controller-bundle \
    --build-arg "ZHIXU_HOST_GOOS=${host_os}" --build-arg "ZHIXU_HOST_GOARCH=${host_arch}" \
    --output "type=local,dest=${temporary}" -f "${DOCKERFILE}" "${SCRIPT_DIR}"; then
    find "${temporary}" -depth -mindepth 1 -delete 2>/dev/null || true
    rmdir -- "${temporary}" 2>/dev/null || true
    fail "Host Controller bundle build failed"
  fi
  [[ -f "${temporary}/zhixu-host-controller" && ! -L "${temporary}/zhixu-host-controller" ]] || fail "Controller bundle binary is missing"
  [[ -d "${temporary}/web" && ! -L "${temporary}/web" ]] || fail "Controller web bundle is missing"
  chmod 0700 "${temporary}/zhixu-host-controller"
  [[ ! -e "${BUNDLE_DIR}" && ! -L "${BUNDLE_DIR}" ]] || remove_bundle_directory
  mv -- "${temporary}" "${BUNDLE_DIR}" || fail "could not publish Controller bundle"
}

controller_pid() {
  [[ -e "${CONTROLLER_PID_FILE}" || -L "${CONTROLLER_PID_FILE}" ]] || return 1
  validate_protected_file "${CONTROLLER_PID_FILE}" "Controller PID file"
  local pid
  pid="$(tr -d '\r\n' <"${CONTROLLER_PID_FILE}")"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "${pid}"
}

stop_controller() {
  if [[ ! -e "${CONTROLLER_PID_FILE}" && ! -L "${CONTROLLER_PID_FILE}" ]]; then
    return
  fi
  local pid command process_uid attempt
  pid="$(controller_pid)" || fail "Controller PID file is unsafe"
  if kill -0 "${pid}" 2>/dev/null; then
    command="$(ps -p "${pid}" -o command= 2>/dev/null)" || fail "could not verify Controller process"
    process_uid="$(ps -p "${pid}" -o uid= 2>/dev/null | tr -d '[:space:]')" || fail "could not verify Controller process owner"
    [[ "${process_uid}" == "$(id -u)" && "${command}" == *"${CONTROLLER_BINARY}"* ]] || fail "Controller PID belongs to another process"
    kill -TERM "${pid}" || fail "could not stop Host Controller"
    for ((attempt = 0; attempt < 100; attempt++)); do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 0.05
    done
    kill -0 "${pid}" 2>/dev/null && fail "Host Controller did not stop cleanly"
  fi
  rm -f -- "${CONTROLLER_PID_FILE}"
}

revoke_workspace_runtime() {
  log "revoking any previous Workspace runtime"
  compose --profile workspace-runtime stop proxy app-model-relay worker-model-relay app worker \
    || fail "could not stop the previous Workspace runtime"
  compose --profile workspace-runtime rm --force --stop proxy firewall app-model-relay worker-model-relay app worker \
    || fail "could not remove the previous Workspace runtime"
  remove_active_grant
}

controller_port() {
  local configured
  configured="${ZHIXU_HTTP_PORT:-$(awk -F= '$1 == "ZHIXU_HTTP_PORT" {sub(/\r$/, "", $2); print $2; exit}' "${ENV_FILE}")}" || fail "could not read Controller port"
  [[ "${configured}" =~ ^[1-9][0-9]{0,4}$ && "${configured}" -le 65535 ]] || fail "ZHIXU_HTTP_PORT is invalid"
  printf '%s\n' "${configured}"
}

generate_token() {
  local value
  value="$(LC_ALL=C od -An -N32 -tx1 /dev/urandom | tr -d ' \n')" || fail "could not generate Controller credential"
  [[ "${#value}" -eq 64 ]] || fail "could not generate Controller credential"
  printf '%s\n' "${value}"
}

controller_database_url() {
  local endpoint
  endpoint="$(compose port postgres 5432)" || fail "could not discover the PostgreSQL host port"
  [[ "${endpoint}" =~ ^127\.0\.0\.1:([1-9][0-9]{0,4})$ && "${BASH_REMATCH[1]}" -le 65535 ]] \
    || fail "PostgreSQL is not published on an IPv4 loopback port"
  compose config --format json | python3 -c '
import json
import sys
from urllib.parse import quote

endpoint = sys.argv[1]
model = json.load(sys.stdin)
environment = model.get("services", {}).get("postgres", {}).get("environment", {})
if not isinstance(environment, dict):
    raise SystemExit("PostgreSQL environment is unavailable")
database = environment.get("POSTGRES_DB")
username = environment.get("POSTGRES_USER")
password = environment.get("POSTGRES_PASSWORD")
if not all(isinstance(value, str) and value for value in (database, username, password)):
    raise SystemExit("PostgreSQL credentials are unavailable")
print(
    "postgres://{}:{}@{}/{}?sslmode=disable".format(
        quote(username, safe=""),
        quote(password, safe=""),
        endpoint,
        quote(database, safe=""),
    )
)
' "${endpoint}" || fail "could not derive the Controller database connection"
}

start_controller() {
  local port token database_url pid attempt ready=0
  port="$(controller_port)"
  token="$(generate_token)"
  database_url="$(controller_database_url)"
  (umask 077; : >"${CONTROLLER_LOG_FILE}") || fail "could not create Controller log"
  chmod 0600 "${CONTROLLER_LOG_FILE}"
  # macOS still ships Bash 3.2, so use a fixed inherited descriptor instead of
  # the Bash 4 dynamic-FD syntax.
  exec 8<<<"${database_url}"
  exec 9<<<"${token}"
  nohup "${CONTROLLER_BINARY}" \
    --addr "127.0.0.1:${port}" \
    --assets "${CONTROLLER_ASSETS}" \
    --state-dir "${STATE_DIR}" \
    --compose-file "${COMPOSE_FILE}" \
    --env-file "${ENV_FILE}" \
    --grant-override "${GRANT_OVERRIDE}" \
    --database-url-fd 8 \
    --bootstrap-token-fd 9 \
    >"${CONTROLLER_LOG_FILE}" 2>&1 </dev/null &
  pid=$!
  exec 8<&-
  exec 9<&-
  (umask 077; printf '%s\n' "${pid}" >"${CONTROLLER_PID_FILE}") || fail "could not write Controller PID"
  chmod 0600 "${CONTROLLER_PID_FILE}"
  for ((attempt = 0; attempt < 100; attempt++)); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      break
    fi
    if curl --fail --silent --show-error --connect-timeout 1 --max-time 2 --output /dev/null \
      -H "Host: 127.0.0.1:${port}" "http://127.0.0.1:${port}/control/v1/livez"; then
      ready=1
      break
    fi
    sleep 0.05
  done
  if [[ "${ready}" -ne 1 ]]; then
    stop_controller
    fail "Host Controller liveness check failed"
  fi
  log "ready: http://127.0.0.1:${port}/#control=${token}"
}

run_up() {
  require_command curl
  require_command docker
  require_command id
  require_command od
  require_command python3
  validate_project_scope
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"
  docker buildx version >/dev/null 2>&1 || fail "Docker Buildx is unavailable"
  initialize_local_state
  validate_compose
  stop_controller
  revoke_workspace_runtime
  ensure_empty_grant_override
  start_base_stack
  build_controller_bundle
  start_controller
}

run_restart() {
  run_up
}

run_status() {
  require_command curl
  require_command docker
  validate_project_scope
  validate_optional_state_directory
  select_existing_env
  compose --profile workspace-runtime --profile modelctl ps
  local port pid status="stopped"
  port="$(controller_port)"
  if [[ -e "${CONTROLLER_PID_FILE}" || -L "${CONTROLLER_PID_FILE}" ]]; then
    pid="$(controller_pid)" || fail "Controller PID file is invalid"
  fi
  if [[ -n "${pid:-}" ]] && kill -0 "${pid}" 2>/dev/null; then
    status="unavailable"
    if curl --fail --silent --connect-timeout 1 --max-time 2 --output /dev/null \
      -H "Host: 127.0.0.1:${port}" "http://127.0.0.1:${port}/control/v1/livez"; then
      status="ready"
    fi
  fi
  printf 'Controller: %s\nURL: http://127.0.0.1:%s/\n' "${status}" "${port}"
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
    printf 'Grant: configured (details require a Controller session)\n'
  else
    printf 'Grant: waiting for Workspace selection\n'
  fi
}

run_logs() {
  require_command docker
  validate_project_scope
  validate_optional_state_directory
  select_existing_env
  local service="${1:-controller}"
  [[ $# -le 1 ]] || fail "logs accepts at most one service"
  if [[ "${service}" == "controller" ]]; then
    validate_protected_file "${CONTROLLER_LOG_FILE}" "Controller log"
    tail -n 200 -f -- "${CONTROLLER_LOG_FILE}"
    return
  fi
  case "${service}" in
    postgres|model-settings-key-init|migrate|app|worker|app-model-relay|worker-model-relay|firewall|proxy|modelctl) ;;
    *) fail "unknown service: ${service}" ;;
  esac
  compose --profile workspace-runtime --profile modelctl logs --follow --tail 200 "${service}"
}

remove_active_grant() {
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
    rm -f -- "${GRANT_OVERRIDE}"
  fi
}

run_down() {
  require_command docker
  validate_project_scope
  select_existing_env
  stop_controller
  compose --profile workspace-runtime --profile modelctl down --remove-orphans
  remove_active_grant
  log "stopped; PostgreSQL and model-secret volumes were preserved; no Workspace remains granted"
}

run_reset() {
  require_command docker
  validate_project_scope
  select_existing_env
  local confirmation=""
  if [[ $# -eq 2 && "$1" == "--confirm" ]]; then
    confirmation=$2
  elif [[ $# -eq 0 && -t 0 ]]; then
    printf 'This deletes the zhixu PostgreSQL and model-secret volumes. Type DELETE to continue: '
    IFS= read -r confirmation
  else
    fail "reset requires an interactive confirmation or --confirm DELETE"
  fi
  [[ "${confirmation}" == "DELETE" ]] || fail "reset confirmation did not match DELETE"
  stop_controller
  compose down --volumes --remove-orphans
  remove_active_grant
  log "deleted Compose volumes and cleared the active grant; host Workspace files were not touched"
}

main() {
  local command="${1:-help}"
  [[ $# -eq 0 ]] || shift
  case "${command}" in
    up) [[ $# -eq 0 ]] || fail "up accepts no arguments"; run_with_mutation_lock up run_up ;;
    restart) [[ $# -eq 0 ]] || fail "restart accepts no arguments"; run_with_mutation_lock restart run_restart ;;
    status) [[ $# -eq 0 ]] || fail "status accepts no arguments"; run_status ;;
    logs) run_logs "$@" ;;
    down) [[ $# -eq 0 ]] || fail "down accepts no arguments"; run_with_mutation_lock down run_down ;;
    reset) run_with_mutation_lock reset run_reset "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; fail "unknown command: ${command}" ;;
  esac
}

main "$@"
