run_local_model_migrate() {
  local shape image_id source_image_id snapshot_digest snapshot_base64 fingerprint destination_state
  local source_tree_fingerprint source_tree_fingerprint_after_stop destination_tree_fingerprint
  require_command docker
  require_command python3
  validate_project_scope
  select_existing_env
  if [[ $# -ne 0 && ! ( $# -eq 2 && "$1" == --confirm && "$2" == MIGRATE ) ]]; then
    fail "local-model migrate accepts no arguments or --confirm MIGRATE"
  fi
  image_id="$(managed_model_image_id)"

  if ! docker_container_exists "${LEGACY_MODEL_CONTAINER}"; then
    docker_volume_exists "${LEGACY_MODEL_VOLUME}" || fail "legacy model source volume is absent"
    validate_legacy_model_volume
    docker_volume_exists "${MANAGED_MODEL_VOLUME}" || fail "legacy container is absent and no managed model volume exists"
    validate_managed_model_volume
    legacy_model_migration_completed "${image_id}" \
      || fail "legacy container is absent but the managed migration marker is not verified"
    log "legacy model migration was already completed; rollback volume ${LEGACY_MODEL_VOLUME} remains preserved"
    return
  fi

  shape="$(legacy_model_container_shape)" || fail "legacy model container is outside the migration allowlist"
  [[ "${shape%%$'\t'*}" == running ]] \
    || fail "legacy model container must be explicitly started before its API snapshot can be migrated"
  source_image_id="${shape#*$'\t'}"
  validate_legacy_model_image "${source_image_id}"
  validate_legacy_model_volume
  capture_legacy_model_snapshot
  snapshot_digest="$(legacy_model_snapshot_digest)"
  snapshot_base64="$(legacy_model_snapshot_base64)"
  source_tree_fingerprint="$(legacy_helper_source_tree_fingerprint "${image_id}")" \
    || fail "could not fingerprint the legacy model tree"
  fingerprint="$(legacy_model_source_fingerprint "${source_image_id}" "${snapshot_digest}" "${source_tree_fingerprint}")"

  docker_volume_exists "${MANAGED_MODEL_VOLUME}" \
    || fail "managed model destination is absent; run ./zhixu up before migration"
  validate_managed_model_volume
  legacy_helper_source_preflight "${image_id}" \
    || fail "legacy model source or destination free-space preflight failed"
  if docker_volume_exists "${MANAGED_MODEL_VOLUME}"; then
    destination_state="$(legacy_helper_destination_state "${image_id}" "${fingerprint}" "${snapshot_digest}" "${snapshot_base64}")" \
      || fail "managed model destination is not empty or does not match this migration"
  else
    destination_state=fresh
  fi
  printf 'Legacy source: %s (%s)\nSource fingerprint: %s\nModels:\n' \
    "${LEGACY_MODEL_VOLUME}" "${LEGACY_MODEL_IMAGE}" "${fingerprint}"
  sed 's/^/  /' "${LEGACY_MIGRATION_SNAPSHOT_FILE}"
  confirm_legacy_model_migration "$@"

  # The source tree is never mutated. Register rollback before stop so a signal
  # cannot strand an originally-running legacy container between the two steps.
  LEGACY_MIGRATION_RESTORE_NEEDED=1
  run_mutation_command docker stop --time 90 "${LEGACY_MODEL_CONTAINER}" >/dev/null \
    || fail "could not stop the legacy model container"
  shape="$(legacy_model_container_shape)" || fail "legacy model container changed during migration"
  [[ "${shape}" == stopped$'\t'"${source_image_id}" ]] || fail "legacy model container did not stop in the approved shape"
  validate_legacy_model_volume
  source_tree_fingerprint_after_stop="$(legacy_helper_source_tree_fingerprint "${image_id}")" \
    || fail "could not re-fingerprint the stopped legacy model tree"
  [[ "${source_tree_fingerprint_after_stop}" == "${source_tree_fingerprint}" ]] \
    || fail "legacy model tree changed between confirmation and stop"
  [[ -z "$(docker ps --filter publish=11434 --format '{{.Names}}')" ]] \
    || fail "legacy loopback port is still published after stop"

  compose_without_grant --profile workspace-runtime stop local-model-runtime >/dev/null 2>&1 || true
  compose_without_grant --profile workspace-runtime rm --force --stop local-model-runtime >/dev/null 2>&1 || true
  docker_volume_exists "${MANAGED_MODEL_VOLUME}" || fail "managed model destination disappeared after confirmation"
  validate_managed_model_volume
  destination_state="$(legacy_helper_destination_state "${image_id}" "${fingerprint}" "${snapshot_digest}" "${snapshot_base64}")" \
    || fail "managed model destination changed after confirmation"
  if [[ "${destination_state}" == fresh ]]; then
    copy_legacy_model_volume "${image_id}" "${fingerprint}" "${snapshot_digest}" "${snapshot_base64}" \
      || fail "legacy model copy failed"
  elif [[ "${destination_state}" != copied && "${destination_state}" != verified ]]; then
    fail "managed model destination state is invalid"
  fi
  destination_tree_fingerprint="$(legacy_helper_destination_tree_fingerprint "${image_id}")" \
    || fail "could not fingerprint the copied managed model tree"
  [[ "${destination_tree_fingerprint}" == "${source_tree_fingerprint}" ]] \
    || fail "copied managed model tree differs from the read-only legacy source"
  verify_legacy_model_copy "${image_id}" "${fingerprint}" "${snapshot_digest}" "${snapshot_base64}"
  mark_legacy_model_copy_verified "${image_id}" "${fingerprint}" "${snapshot_digest}" "${snapshot_base64}"
  compose_without_grant --profile workspace-runtime up --detach --wait local-model-runtime \
    || fail "managed local model runtime did not become healthy"
  run_mutation_command docker rm "${LEGACY_MODEL_CONTAINER}" >/dev/null \
    || fail "could not remove the migrated legacy container"
  docker_volume_exists "${LEGACY_MODEL_VOLUME}" || fail "legacy rollback volume disappeared during migration"
  LEGACY_MIGRATION_RESTORE_NEEDED=0
  log "migrated legacy models; source volume ${LEGACY_MODEL_VOLUME} was preserved for rollback"
}

run_status() {
  require_command docker
  require_command python3
  validate_project_scope
  validate_optional_state_directory
  select_existing_env
  printf 'Project: %s\n' "${PROJECT_NAME}"
  compose_without_grant --profile workspace-runtime ps --all || true
  printf 'Project: %s\n' "${NETNS_PROJECT_NAME}"
  netns_compose ps --all || true
  local main_status helper_status port
  port="$(validated_port ZHIXU_HTTP_PORT 8080)"
  main_status="$(compose_without_grant --profile workspace-runtime \
    ps --all --format json postgres local-model-runtime app worker app-model-relay worker-model-relay 2>/dev/null || true)"
  helper_status="$(netns_compose ps --all --format json app-netns worker-netns 2>/dev/null || true)"
  if printf '%s' "${main_status}" | runtime_status_is_ready postgres=healthy local-model-runtime=healthy app=healthy worker=healthy \
      app-model-relay=healthy worker-model-relay=healthy \
      && printf '%s' "${helper_status}" | runtime_status_is_ready app-netns=healthy worker-netns=healthy \
      && helper_stack_matches "${port}" \
      && host_runtime_ready "${port}"; then
    printf 'Runtime: ready\n'
  else
    printf 'Runtime: degraded\n'
  fi
  printf 'URL: http://127.0.0.1:%s/\n' "${port}"
  if selection_exists; then
    load_selection
    printf 'Workspace: selected\nRoot: %s\n' "${SELECTION_ROOT}"
  else
    printf 'Workspace: not selected\n'
  fi
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
    printf 'Grant: active\n'
  else
    printf 'Grant: revoked\n'
  fi
}

run_logs() {
  require_command docker
  validate_project_scope
  validate_optional_state_directory
  select_existing_env
  local service="${1:-app}"
  [[ $# -le 1 ]] || fail "logs accepts at most one service"
  case "${service}" in
    app-netns|worker-netns)
      validate_netns_resource_ownership
      netns_compose logs --follow --tail 200 "${service}"
      return
      ;;
    postgres|local-model-runtime|app|worker|app-model-relay|worker-model-relay) ;;
    *) fail "unknown service: ${service}" ;;
  esac
  compose_without_grant --profile workspace-runtime logs --follow --tail 200 "${service}"
}

remove_active_grant() {
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
    rm -f -- "${GRANT_OVERRIDE}"
  fi
}

remove_selection() {
  if selection_exists; then
    validate_protected_file "${SELECTION_FILE}" "Workspace selection"
    rm -f -- "${SELECTION_FILE}"
  fi
}

run_down() {
  require_command docker
  validate_project_scope
  validate_optional_state_directory
  select_existing_env
  validate_netns_resource_ownership
  compose_without_grant --profile workspace-runtime stop \
    app-model-relay worker-model-relay app worker local-model-runtime >/dev/null 2>&1 || true
  compose_without_grant --profile workspace-runtime rm --force --stop \
    app-model-relay worker-model-relay app worker local-model-runtime >/dev/null 2>&1 || true
  compose_without_grant --profile workspace-runtime down --remove-orphans || true
  remove_project_containers "${PROJECT_NAME}"
  remove_project_networks "${PROJECT_NAME}"
  teardown_netns_project
  remove_active_grant
  log "stopped; selection, PostgreSQL, model secrets, and host Workspace files were preserved"
}

run_reset() {
  require_command docker
  validate_project_scope
  validate_optional_state_directory
  select_existing_env
  local confirmation=""
  if [[ $# -eq 2 && "$1" == "--confirm" ]]; then
    confirmation=$2
  elif [[ $# -eq 0 && -t 0 ]]; then
    printf 'This deletes the zhixu PostgreSQL, model-secret, managed-model, and runtime-credential volumes. Type DELETE to continue: '
    IFS= read -r confirmation
  else
    fail "reset requires an interactive confirmation or --confirm DELETE"
  fi
  [[ "${confirmation}" == "DELETE" ]] || fail "reset confirmation did not match DELETE"
  if selection_exists; then
    validate_protected_file "${SELECTION_FILE}" "Workspace selection"
  fi
  if [[ -e "${GRANT_OVERRIDE}" || -L "${GRANT_OVERRIDE}" ]]; then
    validate_protected_file "${GRANT_OVERRIDE}" "Workspace grant file"
  fi
  validate_netns_resource_ownership
  validate_main_project_volumes
  compose_without_grant --profile workspace-runtime stop \
    app-model-relay worker-model-relay app worker local-model-runtime >/dev/null 2>&1 || true
  compose_without_grant --profile workspace-runtime rm --force --stop \
    app-model-relay worker-model-relay app worker local-model-runtime >/dev/null 2>&1 || true
  compose_without_grant --profile workspace-runtime down --volumes --remove-orphans || \
    log "Compose volume teardown was incomplete; applying validated fallback cleanup"
  remove_project_containers "${PROJECT_NAME}"
  remove_project_networks "${PROJECT_NAME}"
  remove_main_project_volumes
  teardown_netns_project
  remove_active_grant
  remove_selection
  log "deleted Compose volumes and cleared selection/grant; host Workspace files were not touched"
}

main() {
  local command="${1:-help}"
  [[ $# -eq 0 ]] || shift
  case "${command}" in
    up)
      if [[ $# -eq 0 ]]; then
        run_with_mutation_lock up run_up 0 "" 0
      elif [[ $# -eq 2 && "$1" == "--workspace" && -n "$2" ]]; then
        run_with_mutation_lock up run_up 1 "$2" 0
      elif [[ $# -eq 3 && "$1" == "--workspace" && -n "$2" && "$3" == "--initialize-git" ]]; then
        run_with_mutation_lock up run_up 1 "$2" 1
      else
        fail "up accepts no arguments or --workspace ABS [--initialize-git]"
      fi
      ;;
    restart)
      [[ $# -eq 0 ]] || fail "restart accepts no arguments"
      run_with_mutation_lock restart run_restart
      ;;
    workspace)
      if [[ $# -eq 2 && "$1" == "switch" && -n "$2" ]]; then
        run_with_mutation_lock workspace-switch run_workspace_switch "$2" 0
      elif [[ $# -eq 3 && "$1" == "switch" && -n "$2" && "$3" == "--initialize-git" ]]; then
        run_with_mutation_lock workspace-switch run_workspace_switch "$2" 1
      elif [[ $# -eq 3 && "$1" == "rebind" && "$2" == "--confirm" && "$3" == "REBIND" ]]; then
        run_with_mutation_lock workspace-rebind run_workspace_rebind "$3"
      else
        fail "workspace requires: switch ABS [--initialize-git] or rebind --confirm REBIND"
      fi
      ;;
    status)
      [[ $# -eq 0 ]] || fail "status accepts no arguments"
      run_status
      ;;
    local-model)
      case "${1:-}" in
        status)
          [[ $# -eq 1 ]] || fail "local-model status accepts no arguments"
          run_local_model_status
          ;;
        migrate)
          shift
          run_with_mutation_lock local-model-migrate run_local_model_migrate "$@"
          ;;
        *) fail "local-model requires: status or migrate [--confirm MIGRATE]" ;;
      esac
      ;;
    logs) run_logs "$@" ;;
    down)
      [[ $# -eq 0 ]] || fail "down accepts no arguments"
      run_with_mutation_lock down run_down
      ;;
    reset) run_with_mutation_lock reset run_reset "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; fail "unknown command: ${command}" ;;
  esac
}

main "$@"
