    or config.get("Image") != image_name
    or (config.get("Labels") or {}) != {}
    or config.get("User", "") not in ("", "0", "0:0")
    or config.get("Entrypoint") != ["/bin/ollama"]
    or config.get("Cmd") != ["serve"]
    or (config.get("ExposedPorts") or {}) not in ({}, {"11434/tcp": {}})
    or (config.get("Volumes") or {}) not in ({}, {"/root/.ollama": {}})
    or host.get("NetworkMode") not in ("default", "bridge")
    or host.get("Privileged") is not False
    or host.get("ReadonlyRootfs") is not False
    or host.get("AutoRemove") is not False
    or restart.get("Name") not in ("", "no")
    or restart.get("MaximumRetryCount", 0) != 0
    or (host.get("PortBindings") or {}) != expected_ports
    or host.get("Binds") not in (None, [])
    or host.get("Devices") not in (None, [])
    or host.get("DeviceRequests") not in (None, [])
    or host.get("CapAdd") not in (None, [])
    or host.get("CapDrop") not in (None, [])
    or host.get("SecurityOpt") not in (None, [])
    or host.get("ExtraHosts") not in (None, [])
    or host.get("Links") not in (None, [])
    or host.get("VolumesFrom") not in (None, [])
    or set(networks) != {"bridge"}
):
    raise SystemExit("legacy container does not match the approved shape")
if len(mounts) != 1:
    raise SystemExit("legacy container mount count is invalid")
mount = mounts[0]
if (
    mount.get("Type") != "volume"
    or mount.get("Name") != volume_name
    or mount.get("Destination") != "/root/.ollama"
    or mount.get("RW") is not True
):
    raise SystemExit("legacy container mount is invalid")

allowed_environment = {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "LD_LIBRARY_PATH": "/usr/local/nvidia/lib:/usr/local/nvidia/lib64",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    "OLLAMA_HOST": "0.0.0.0:11434",
}
environment = {}
for entry in config.get("Env") or []:
    if not isinstance(entry, str) or "=" not in entry:
        raise SystemExit("legacy container environment is invalid")
    key, value = entry.split("=", 1)
    if key in environment or key not in allowed_environment or value != allowed_environment[key]:
        raise SystemExit("legacy container environment is outside the allowlist")
    environment[key] = value
if "PATH" not in environment:
    raise SystemExit("legacy container PATH is missing")

status = state.get("Status")
if status not in ("running", "exited"):
    raise SystemExit("legacy container state is not migratable")
image_id = item.get("Image")
if not isinstance(image_id, str) or re.fullmatch(r"sha256:[0-9a-f]{64}", image_id) is None:
    raise SystemExit("legacy container image ID is invalid")
print(("running" if status == "running" else "stopped") + "\t" + image_id)
PY
}

